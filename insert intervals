#include <stdio.h>
#include <stdlib.h>

int** insert(int** intervals, int intervalsSize, int* intervalsColSize, int* newInterval, int newIntervalSize, int* returnSize, int** returnColumnSizes) {
  
    int** res = (int**)malloc((intervalsSize + 1) * sizeof(int*));
    int i = 0;
    int resSize = 0;

    // 1. Add all intervals that end before newInterval starts
    while (i < intervalsSize && intervals[i][1] < newInterval[0]) {
        res[resSize] = (int*)malloc(2 * sizeof(int));
        res[resSize][0] = intervals[i][0];
        res[resSize][1] = intervals[i][1];
        resSize++;
        i++;
    }

    while (i < intervalsSize && intervals[i][0] <= newInterval[1]) {
        // newInterval[0] = min(newInterval[0], intervals[i][0])
        if (intervals[i][0] < newInterval[0]) {
            newInterval[0] = intervals[i][0];
        }
        // newInterval[1] = max(newInterval[1], intervals[i][1])
        if (intervals[i][1] > newInterval[1]) {
            newInterval[1] = intervals[i][1];
        }
        i++;
    }
    
    // Add the merged newInterval
    res[resSize] = (int*)malloc(2 * sizeof(int));
    res[resSize][0] = newInterval[0];
    res[resSize][1] = newInterval[1];
    resSize++;

    while (i < intervalsSize) {
        res[resSize] = (int*)malloc(2 * sizeof(int));
        res[resSize][0] = intervals[i][0];
        res[resSize][1] = intervals[i][1];
        resSize++;
        i++;
    }

  
    *returnSize = resSize;
    *returnColumnSizes = (int*)malloc(resSize * sizeof(int));
    for (int j = 0; j < resSize; j++) {
        (*returnColumnSizes)[j] = 2; // Each interval always has a size of 2
    }

    return res;
}

