#include <stdbool.h>
#include <string.h>

bool isMatch(const char *s, const char *p) {
    int s_idx = 0, p_idx = 0;
    int star_idx = -1;
    int match_idx = 0;
    
    int s_len = strlen(s);
    int p_len = strlen(p);
    
    while (s_idx < s_len) {
        // 1. Exact match or '?' wildcard
        if (p_idx < p_len && (p[p_idx] == s[s_idx] || p[p_idx] == '?')) {
            s_idx++;
            p_idx++;
        }
        // 2. Found a '*' wildcard, record positions and try matching 0 characters first
        else if (p_idx < p_len && p[p_idx] == '*') {
            star_idx = p_idx;
            match_idx = s_idx;
            p_idx++;
        }
        // 3. Characters mismatch, but a previous '*' was found:
        // Backtrack and assume the '*' matches one more character in string 's'
        else if (star_idx != -1) {
            p_idx = star_idx + 1;
            match_idx++;
            s_idx = match_idx;
        }
        // 4. Mismatch and no previous '*' to fall back on
        else {
            return false;
        }
    }
    
    // Check if the remaining characters in the pattern are all '*'
    while (p_idx < p_len && p[p_idx] == '*') {
        p_idx++;
    }
    
    return p_idx == p_len;
}
