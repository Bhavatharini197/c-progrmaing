include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* plusOne(int* digits, int digitsSize, int* returnSize) {
    // Traverse the array from right to left
    for (int i = digitsSize - 1; i >= 0; i--) {
        // If the current digit is less than 9, increment it and return
        if (digits[i] < 9) {
            digits[i]++;
            
            // Allocate memory for the result array
            int* result = (int*)malloc(digitsSize * sizeof(int));
            for (int j = 0; j < digitsSize; j++) {
                result[j] = digits[j];
            }
            *returnSize = digitsSize;
            return result;
        }
        
        // If the digit is 9, it becomes 0 due to the carry
        digits[i] = 0;
    }
    
    // If the loop finishes, it means all digits were 9 (e.g., 999 -> 1000)
    // We need an extra slot for the leading 1
    *returnSize = digitsSize + 1;
    int* result = (int*)malloc((*returnSize) * sizeof(int));
    
    result[0] = 1; // Set the first digit to 1
    for (int j = 1; j < *returnSize; j++) {
        result[j] = 0; // The rest are 0s
    }
    
    return result;
}
